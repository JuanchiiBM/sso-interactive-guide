---
import Layout from '@layouts/Layout.astro'
import SimuladorStage from '@components/SimuladorStage.astro'
import MultipleChoice from '@components/MultipleChoice.astro'
import SemaforosDesafio from '@components/SemaforosDesafio.astro'
import { getEntry, render } from 'astro:content'
import { getEjercicios, ejercicioHref, temaHref, rotuloEjercicio } from '@lib/catalogo'
import { algoritmoUI, dificultadUI, tipoUI } from '@lib/presentacion'

export async function getStaticPaths() {
  const ejercicios = await getEjercicios()
  return ejercicios.map((ejercicio) => {
    const hermanos = ejercicios.filter((e) => e.data.tema.id === ejercicio.data.tema.id)
    const i = hermanos.indexOf(ejercicio)
    return {
      params: { id: ejercicio.id },
      props: { ejercicio, anterior: hermanos[i - 1], siguiente: hermanos[i + 1] },
    }
  })
}

const { ejercicio, anterior, siguiente } = Astro.props
const { titulo, fuente, dificultad, tipo, tags, simulaciones, preguntas, semaforos } = ejercicio.data
const interactivos = simulaciones.length + preguntas.length + semaforos.length
const tema = await getEntry(ejercicio.data.tema)
const { Content } = await render(ejercicio)
const dif = dificultadUI[dificultad]
const ayuda = [
  simulaciones.length > 0 &&
    'Armá el Gantt: en cada instante marcá quién usa la CPU (click) y quién usa el dispositivo de E/S (click derecho). Dejá vacío lo que está en listos o esperando.',
  preguntas.length > 0 &&
    'Elegí una opción por pregunta y verificá. Si fallás, te decimos por qué esa opción no es.',
  semaforos.length > 0 &&
    'Declará los semáforos arriba (semaphore nombre = valor; o un array: semaphore nombre[N] = valor;) y agregá wait(nombre); / signal(nombre); en cada función, sin tocar el resto del código. El editor marca en rojo los errores de sintaxis mientras escribís. Los tests prueban todas las intercalaciones posibles; los nombres de los semáforos no importan.',
  interactivos > 0 &&
    'La resolución se desbloquea cuando acertás. Si ya la resolviste, "Ver resolución" la muestra directo; si no, "Me rindo" pide confirmar.',
].filter((t): t is string => Boolean(t))
const etiquetaSim = (sim: (typeof simulaciones)[number]) =>
  sim.etiqueta ?? `Gantt · ${algoritmoUI[sim.algoritmo] ?? sim.algoritmo}`
---

<Layout title={`${rotuloEjercicio(fuente.numero)} · ${titulo}`} activeId={ejercicio.id}>
  <article class="mx-auto max-w-6xl">
    <nav class="text-xs text-muted" aria-label="Ubicación">
      <a href="/ejercicios/" class="hover:text-fg">
        Ejercicios
      </a>
      <span aria-hidden="true"> / </span>
      <a href={temaHref(tema!.id)} class="hover:text-fg">
        {tema!.data.titulo}
      </a>
    </nav>

    <h1 class="mt-3 font-heading text-2xl md:text-3xl text-fg">
      <span class="text-muted">{rotuloEjercicio(fuente.numero)}</span> · {titulo}
    </h1>

    <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-2 text-xs text-fg-soft">
      <span class="inline-flex items-center gap-1.5">
        <span class="size-1.5 rounded-full" style={`background:${dif.color}`}></span>
        {dif.label}
      </span>
      <span>{tipoUI[tipo]}</span>
      <span class="text-muted">{fuente.guia}</span>
      {tags.map((t) => (
        <span class="font-mono text-muted">#{t}</span>
      ))}
    </div>

    <section class="prose mt-8 max-w-none" aria-label="Enunciado">
      <Content />
    </section>

    <section class="mt-12" aria-labelledby="resolucion">
      <div class="mb-4 flex items-center gap-2">
        <h2 id="resolucion" class="font-heading text-xl text-fg">
          Resolución
        </h2>
        {ayuda.length > 0 && (
          <>
            <button
              type="button"
              popovertarget="ayuda-resolucion"
              class="info-boton inline-flex size-7 items-center justify-center rounded-full text-muted hover:text-fg hover:bg-hover"
              aria-label="Cómo se resuelve"
            >
              <svg
                class="size-4"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
              >
                <circle cx="12" cy="12" r="9" />
                <path stroke-linecap="round" d="M12 11v5M12 8h.01" />
              </svg>
            </button>
            <div id="ayuda-resolucion" popover class="info-popover">
              {ayuda.map((texto) => (
                <p>{texto}</p>
              ))}
            </div>
          </>
        )}
      </div>
      {interactivos > 0 ? (
        <div class="flex flex-col gap-4">
          {preguntas.map((p, i) => (
            <MultipleChoice pregunta={p} clave={String(i)} />
          ))}
          {semaforos.map((d, i) => (
            <SemaforosDesafio desafio={d} clave={String(i)} />
          ))}
          {simulaciones.map((sim) => (
            <SimuladorStage simulacion={sim} titulo={etiquetaSim(sim)} />
          ))}
        </div>
      ) : (
        <p class="rounded-xl border border-dashed border-line p-4 text-sm text-muted">
          Todavía no hay resolución cargada para este ejercicio.
        </p>
      )}
    </section>

    <nav
      class="mt-14 flex justify-between gap-4 border-t border-line pt-6 text-sm"
      aria-label="Navegación entre ejercicios"
    >
      {anterior ? (
        <a href={ejercicioHref(anterior.id)} class="text-muted hover:text-fg">
          ← {rotuloEjercicio(anterior.data.fuente.numero)} · {anterior.data.titulo}
        </a>
      ) : (
        <span />
      )}
      {siguiente && (
        <a href={ejercicioHref(siguiente.id)} class="text-muted hover:text-fg text-right">
          {rotuloEjercicio(siguiente.data.fuente.numero)} · {siguiente.data.titulo} →
        </a>
      )}
    </nav>
  </article>
</Layout>
