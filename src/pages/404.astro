---
import Layout from '@layouts/Layout.astro'
---

<Layout title="Página no encontrada">
  <div class="max-w-xl">
    <p class="font-mono text-sm text-muted">404 · SIGSEGV</p>
    <h1 class="mt-2 font-heading text-3xl text-fg">Esta página no está mapeada</h1>
    <p class="mt-3 text-fg-soft">
      Intentaste acceder a una dirección que no pertenece a ningún segmento. El SO te manda de
      vuelta a un lugar seguro.
    </p>
    <div class="mt-6 flex gap-3 text-sm">
      <a href="/" class="rounded-lg bg-fg text-surface px-4 py-2">
        Inicio
      </a>
      <a href="/ejercicios/" class="rounded-lg border border-line-strong px-4 py-2 text-fg">
        Ejercicios
      </a>
    </div>
  </div>
</Layout>
