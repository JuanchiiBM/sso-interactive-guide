---
/** Metodología de resolución de un tema: mapa de tipos y, por tipo, receta, ejemplo y trampas. */
import Layout from '@layouts/Layout.astro'
import ChecklistEntrega from '@components/ChecklistEntrega.astro'
import { render } from 'astro:content'
import {
  getCatalogo,
  getMetodologias,
  parcialUI,
  temaHref,
  ejercicioHref,
  rotuloEjercicio,
} from '@lib/catalogo'
import { exigir, idTipo } from '@lib/metodologia/validar'
import { markdownInlineAHtml } from '@lib/markdown/marked'

export async function getStaticPaths() {
  const [catalogo, metodologias] = await Promise.all([getCatalogo(), getMetodologias()])
  return catalogo
    .filter(({ tema }) => metodologias.has(tema.id))
    .map(({ tema, ejercicios }) => ({
      params: { id: tema.id },
      props: { tema, ejercicios, tipos: metodologias.get(tema.id)! },
    }))
}

const { tema, ejercicios, tipos } = Astro.props
const { headings } = await render(tema)
const titulos = new Map(headings.map((h) => [h.slug, h.text]))
const ids = tipos.map((t) => idTipo(t.id))
for (const e of ejercicios) exigir(e.data.metodo, ids, `ejercicio ${e.id}, metodo`)

const secciones = await Promise.all(
  tipos.map(async (t) => {
    const id = idTipo(t.id)
    const teoria = t.data.teoria.map((r) => (typeof r === 'string' ? { ancla: r, texto: '' } : r))
    exigir(
      teoria.map((r) => r.ancla),
      titulos.keys(),
      `metodología ${t.id}, ancla de teoría`,
    )
    const practica = ejercicios.filter((e) => e.data.metodo.includes(id))
    return {
      id,
      tipo: t,
      Content: (await render(t)).Content,
      trampas: await Promise.all(t.data.trampas.map((m) => markdownInlineAHtml(m))),
      teoria: teoria.map((r) => ({ ...r, texto: r.texto || titulos.get(r.ancla)! })),
      practica,
    }
  }),
)
const toc = [
  { slug: 'mapa-de-tipos', text: 'Mapa de tipos' },
  ...tipos.map((t) => ({ slug: idTipo(t.id), text: t.data.titulo })),
  { slug: 'antes-de-entregar', text: 'Antes de entregar' },
]
// "Ej. 3, Ej. 4 y Ej. 6"
const separador = (i: number, n: number) => (i === 0 ? '' : i === n - 1 ? ' y ' : ', ')
---

<Layout
  title={`Metodología · ${tema.data.titulo}`}
  description={`Cómo se resuelven los ejercicios de ${tema.data.titulo}: tipos, recetas y trampas.`}
  activeId={`metodologia/${tema.id}`}
>
  <div class="mx-auto flex max-w-[80rem] gap-10">
    <article class="min-w-0 flex-1" data-pagefind-body data-pagefind-meta="tipo:Metodología">
      <p data-pagefind-ignore class="text-xs uppercase tracking-widest text-muted">
        Metodología · {parcialUI(tema.data.parcial)}
      </p>
      <h1 class="mt-2 font-heading text-3xl text-fg">{tema.data.titulo}</h1>
      <p class="mt-3 text-fg-soft max-w-[60rem]">
        Cómo reconocer cada tipo de ejercicio, la receta para resolverlo y de dónde sale cada
        número.
      </p>
      <details class="xl:hidden mt-4 rounded-lg border border-line px-3 py-2 text-sm">
        <summary class="cursor-pointer text-fg-soft">En esta página</summary>
        <ul class="mt-2 space-y-1.5 border-l border-line pl-3">
          {toc.map((h) => (
            <li>
              <a href={`#${h.slug}`} class="text-muted hover:text-fg">
                {h.text}
              </a>
            </li>
          ))}
        </ul>
      </details>

      <div class="prose metodologia mt-8">
        <h2 id="mapa-de-tipos">Mapa de tipos</h2>
        <p>
          Leé qué te dan y qué te piden: eso dice qué receta usar. Un ejercicio de parcial suele
          pegar dos.
        </p>
        <table class="mapa-tipos">
          <thead>
            <tr>
              <th>Si el enunciado…</th>
              <th>Es</th>
            </tr>
          </thead>
          <tbody>
            {secciones.map((s) => (
              <tr>
                <td>{s.tipo.data.reconocer}</td>
                <td>
                  <a href={`#${s.id}`}>{s.tipo.data.titulo}</a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>

        {secciones.map((s) => (
          <section class="metodo-tipo" aria-labelledby={s.id}>
            <h2 id={s.id}>{s.tipo.data.titulo}</h2>
            <p>{s.tipo.data.resumen}</p>
            <s.Content />
            {s.practica.length > 0 && (
              <p data-pagefind-ignore>
                Practicalo en{' '}
                {s.practica.map((e, i) => (
                  <>
                    {separador(i, s.practica.length)}
                    <a href={ejercicioHref(e.id)}>{rotuloEjercicio(e.data.fuente.numero)}</a>
                  </>
                ))}
                .
              </p>
            )}
            <h3>Trampas</h3>
            <ul>
              {s.trampas.map((t) => (
                <li set:html={t} />
              ))}
            </ul>
            {s.teoria.length > 0 && (
              <>
                <h3>En la teoría</h3>
                <p>
                  {s.teoria.map((r, i) => (
                    <>
                      {i > 0 && ' · '}
                      <a href={`${temaHref(tema.id)}#${r.ancla}`}>{r.texto}</a>
                    </>
                  ))}
                </p>
              </>
            )}
          </section>
        ))}

        <ChecklistEntrega />
      </div>
    </article>

    <aside class="hidden xl:block w-56 shrink-0">
      <nav class="sticky top-24 text-sm" aria-label="En esta página">
        <p class="mb-2 text-[11px] uppercase tracking-wider text-muted">En esta página</p>
        <ul class="space-y-1.5 border-l border-line pl-3">
          {toc.map((h) => (
            <li>
              <a href={`#${h.slug}`} class="text-muted hover:text-fg">
                {h.text}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </aside>
  </div>
</Layout>
