---
/** Un parcial real como simulacro: teoría y práctica en modo examen. Comportamiento: src/lib/parciales/examen.ts */
import Layout from '@layouts/Layout.astro'
import SimuladorStage from '@components/SimuladorStage.astro'
import MultipleChoice from '@components/MultipleChoice.astro'
import SemaforosDesafio from '@components/SemaforosDesafio.astro'
import { render } from 'astro:content'
import { getEjercicios, getParciales, ejercicioHref, rotuloEjercicio } from '@lib/catalogo'
import { algoritmoUI } from '@lib/presentacion'
import { markdownAHtml } from '@lib/markdown/marked'
import { firmaParcial } from '@lib/parciales/resultados'
import type { Parcial } from '@lib/parciales/catalogo'

export async function getStaticPaths() {
  const parciales = await getParciales()
  return parciales.map((parcial) => ({ params: { id: parcial.id }, props: { parcial } }))
}

const { parcial } = Astro.props as { parcial: Parcial }
const porId = new Map((await getEjercicios()).map((e) => [e.id, e]))

// en el examen no se muestra de qué parcial sale cada pregunta: ya lo dice el título
const sinCita = (enunciado: string) => enunciado.replace(/^\([^)]*\)\s*/, '')
const teoria = parcial.teoria.map(({ ejercicioId, indice }) => {
  const pregunta = porId.get(ejercicioId)!.data.preguntas[indice]
  return { ...pregunta, enunciado: sinCita(pregunta.enunciado) }
})
const practica = await Promise.all(
  parcial.practica.map(async (id) => {
    const ejercicio = porId.get(id)!
    const { Content } = await render(ejercicio)
    const nota = ejercicio.data.nota
      ? await markdownAHtml(`**Nota:** ${ejercicio.data.nota.trim()}`)
      : null
    return { ejercicio, Content, nota }
  }),
)
type Simulacion = (typeof practica)[number]['ejercicio']['data']['simulaciones'][number]
const etiquetaSim = (sim: Simulacion) =>
  sim.etiqueta ?? `Gantt · ${algoritmoUI[sim.algoritmo] ?? sim.algoritmo}`
const boton =
  'rounded-lg bg-fg text-surface px-4 py-2 text-sm font-medium hover:opacity-90 disabled:opacity-50'
---

<Layout title={`Simulacro · ${parcial.titulo}`}>
  <article
    class="mx-auto max-w-6xl"
    data-simulacro
    data-simulacro-id={parcial.id}
    data-simulacro-firma={firmaParcial(parcial)}
  >
    <nav class="text-xs text-muted" aria-label="Ubicación">
      <a href="/simulacros/" class="hover:text-fg">
        Simulacros
      </a>
    </nav>
    <h1 class="mt-3 font-heading text-2xl md:text-3xl text-fg">
      <span class="text-muted">Simulacro</span> · {parcial.titulo}
    </h1>
    <p class="mt-3 max-w-3xl text-sm text-fg-soft">
      {teoria.length} preguntas de teoría y {practica.length} ejercicios de práctica, tal como se
      tomaron en el examen. La teoría vale el 40 % y la práctica el 60 %. Las respuestas se ven
      recién al finalizar. Referencia: el parcial real dura 2 horas.
    </p>

    <div
      class="sticky top-0 z-10 mt-6 flex flex-wrap items-center gap-3 rounded-xl border border-line bg-surface-2 px-4 py-3"
      data-simulacro-barra
    >
      <button type="button" class={boton} data-simulacro-accion="empezar">
        Empezar
      </button>
      <span class="font-mono text-lg text-fg" aria-live="off" data-simulacro-reloj>
        00:00
      </span>
      <span class="text-sm text-muted" data-simulacro-estado></span>
    </div>

    <div data-simulacro-contenido>
      <section class="mt-10" aria-labelledby="teoria">
        <h2 id="teoria" class="font-heading text-xl text-fg mb-4">
          Teoría
        </h2>
        <div class="flex flex-col gap-4">
          {teoria.map((pregunta, i) => (
            <div data-item data-item-tipo="mc" data-item-seccion="teoria">
              <MultipleChoice pregunta={pregunta} clave={`t${i}`} modo="examen" />
            </div>
          ))}
        </div>
      </section>

      <section class="mt-12" aria-labelledby="practica">
        <h2 id="practica" class="font-heading text-xl text-fg mb-4">
          Práctica
        </h2>
        <div class="flex flex-col gap-12">
          {practica.map(({ ejercicio, Content, nota }, k) => (
            <section aria-label={`Ejercicio ${k + 1}`}>
              <h3 class="font-heading text-lg text-fg">
                <span class="text-muted">Ejercicio {k + 1}</span> · {ejercicio.data.titulo}
              </h3>
              <div class="prose mt-4 max-w-none">
                <Content />
              </div>
              {nota && (
                <aside class="prose mt-6 max-w-none" aria-label="Nota">
                  <blockquote set:html={nota} />
                </aside>
              )}
              <div class="mt-6 flex flex-col gap-4">
                {ejercicio.data.preguntas.map((p, i) => (
                  <div
                    data-item
                    data-item-tipo="mc"
                    data-item-seccion="practica"
                    data-item-ejercicio={k}
                  >
                    <MultipleChoice pregunta={p} clave={`p${k}-${i}`} modo="examen" />
                  </div>
                ))}
                {ejercicio.data.semaforos.map((d, i) => (
                  <div
                    data-item
                    data-item-tipo="sem"
                    data-item-seccion="practica"
                    data-item-ejercicio={k}
                  >
                    <SemaforosDesafio desafio={d} clave={`p${k}-${i}`} modo="examen" />
                  </div>
                ))}
                {ejercicio.data.simulaciones.map((sim) => (
                  <div
                    data-item
                    data-item-tipo="gantt"
                    data-item-seccion="practica"
                    data-item-ejercicio={k}
                  >
                    <SimuladorStage simulacion={sim} titulo={etiquetaSim(sim)} modo="examen" />
                  </div>
                ))}
              </div>
              <p class="mt-3 text-xs text-muted" data-simulacro-revelar hidden>
                En la práctica:{' '}
                <a href={ejercicioHref(ejercicio.id)} class="underline hover:text-fg">
                  {rotuloEjercicio(ejercicio.data.fuente.numero)} · {ejercicio.data.titulo}
                </a>
              </p>
            </section>
          ))}
        </div>
      </section>
    </div>
  </article>
</Layout>
