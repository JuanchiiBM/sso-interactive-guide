---
import Layout from '@layouts/Layout.astro'
import { getTemas, PARCIALES, parcialUI, temaHref } from '@lib/catalogo'

const temas = await getTemas()
const porParcial = PARCIALES.map((n) => ({
  n,
  temas: temas.filter((t) => t.data.parcial === n),
})).filter((p) => p.temas.length > 0)
---

<Layout title="Teoría">
  <h1 class="font-heading text-2xl text-fg">Teoría</h1>
  <p class="mt-2 text-fg-soft">
    Resumen por tema, con las preguntas de parcial respondidas al final de cada uno.
  </p>
  {porParcial.map(({ n, temas }) => (
    <>
      <h2 class="mt-10 font-heading text-lg text-fg">{parcialUI(n)}</h2>
      <ol class="mt-3 max-w-2xl divide-y divide-line border-y border-line">
        {temas.map((tema, i) => (
          <li>
            <a href={temaHref(tema.id)} class="flex gap-4 py-4 group">
              <span class="font-mono text-sm text-muted pt-0.5">
                {String(i + 1).padStart(2, '0')}
              </span>
              <span>
                <span class="block font-heading text-fg group-hover:text-accent">
                  {tema.data.titulo}
                </span>
                <span class="block mt-1 text-sm text-fg-soft">{tema.data.resumen}</span>
              </span>
            </a>
          </li>
        ))}
      </ol>
    </>
  ))}
</Layout>
