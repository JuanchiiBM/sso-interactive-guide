---
import Layout from '@layouts/Layout.astro'
import EjercicioCard from '@components/EjercicioCard.astro'
import { render } from 'astro:content'
import { getCatalogo, temaHref } from '@lib/catalogo'

export async function getStaticPaths() {
  const catalogo = await getCatalogo()
  return catalogo.map(({ tema, ejercicios }, i) => ({
    params: { id: tema.id },
    props: {
      tema,
      ejercicios,
      anterior: catalogo[i - 1]?.tema,
      siguiente: catalogo[i + 1]?.tema,
    },
  }))
}

const { tema, ejercicios, anterior, siguiente } = Astro.props
const { Content, headings } = await render(tema)
const toc = headings.filter((h) => h.depth === 2)
---

<Layout title={tema.data.titulo} description={tema.data.resumen} activeId={tema.id}>
  <div class="flex gap-10">
    <article class="min-w-0 flex-1">
      <p class="text-xs uppercase tracking-widest text-muted">
        Teoría · {tema.data.parcial}er parcial
      </p>
      <h1 class="mt-2 font-heading text-3xl text-fg">{tema.data.titulo}</h1>
      <p class="mt-3 text-fg-soft max-w-[72ch]">{tema.data.resumen}</p>

      <div class="prose mt-8">
        <Content />
      </div>

      {ejercicios.length > 0 && (
        <section class="mt-14" aria-labelledby="ejercicios-del-tema">
          <h2 id="ejercicios-del-tema" class="font-heading text-xl text-fg mb-4">
            Ejercicios de este tema
          </h2>
          <ul class="grid gap-3 md:grid-cols-2">
            {ejercicios.map((e) => (
              <li>
                <EjercicioCard ejercicio={e} />
              </li>
            ))}
          </ul>
        </section>
      )}

      <nav
        class="mt-14 flex justify-between gap-4 border-t border-line pt-6 text-sm"
        aria-label="Navegación entre temas"
      >
        {anterior ? (
          <a href={temaHref(anterior.id)} class="text-muted hover:text-fg">
            ← {anterior.data.titulo}
          </a>
        ) : (
          <span />
        )}
        {siguiente && (
          <a href={temaHref(siguiente.id)} class="text-muted hover:text-fg">
            {siguiente.data.titulo} →
          </a>
        )}
      </nav>
    </article>

    {toc.length > 2 && (
      <aside class="hidden xl:block w-56 shrink-0">
        <nav class="sticky top-24 text-sm" aria-label="En esta página">
          <p class="mb-2 text-[11px] uppercase tracking-wider text-muted">En esta página</p>
          <ul class="space-y-1.5 border-l border-line pl-3">
            {toc.map((h) => (
              <li>
                <a href={`#${h.slug}`} class="text-muted hover:text-fg">
                  {h.text}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </aside>
    )}
  </div>
</Layout>
