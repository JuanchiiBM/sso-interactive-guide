---
import ThemeToggle from '@components/ThemeToggle.astro'
import { SITE, universidadLabel } from '@lib/site'

const path = Astro.url.pathname
const nav = [
  { href: '/teoria/', label: 'Teoría', active: path.startsWith('/teoria') },
  { href: '/ejercicios/', label: 'Ejercicios', active: path.startsWith('/ejercicios') },
  { href: '/simulacros/', label: 'Simulacros', active: path.startsWith('/simulacros') },
]
---

<header class="sticky top-0 z-40 h-14 flex items-center gap-3 px-3 md:px-5 border-b border-line bg-surface/85 backdrop-blur">
  <button
    type="button"
    data-sidebar-open
    class="md:hidden inline-flex size-8 items-center justify-center rounded-md text-muted hover:text-fg hover:bg-hover"
    aria-label="Abrir menú"
  >
    <svg
      class="size-4"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      aria-hidden="true"
    >
      <path stroke-linecap="round" d="M4 6h16M4 12h16M4 18h16"></path>
    </svg>
  </button>

  <a href="/" class="flex items-center gap-2.5 min-w-0">
    <span
      class="shrink-0 rounded-md border border-line-strong px-1.5 py-0.5 font-heading text-[11px] tracking-wider text-accent"
      title={SITE.universidadNombre}
    >
      {universidadLabel}
    </span>
    <span class="truncate font-heading text-sm text-fg">{SITE.materia}</span>
  </a>

  <nav class="ml-auto flex items-center gap-1" aria-label="Secciones">
    {nav.map((item) => (
      <a
        href={item.href}
        class:list={[
          'px-2.5 py-1.5 rounded-md text-sm transition-colors',
          item.active ? 'text-fg bg-hover' : 'text-muted hover:text-fg hover:bg-hover',
        ]}
        aria-current={item.active ? 'page' : undefined}
      >
        {item.label}
      </a>
    ))}
    <span class="mx-1 h-5 w-px bg-line" aria-hidden="true"></span>
    <a
      href={SITE.repo}
      class="hidden sm:inline-flex size-8 items-center justify-center rounded-md text-muted hover:text-fg hover:bg-hover"
      aria-label="Repositorio en GitHub"
      target="_blank"
      rel="noopener"
    >
      <svg class="size-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M12 .5a11.5 11.5 0 0 0-3.64 22.42c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.78 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.41-2.69 5.39-5.25 5.67.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z"></path>
      </svg>
    </a>
    <ThemeToggle />
  </nav>
</header>
