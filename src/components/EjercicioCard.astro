---
import type { Ejercicio } from '@lib/catalogo'
import { ejercicioHref, rotuloEjercicio } from '@lib/catalogo'
import { dificultadUI, tipoUI } from '@lib/presentacion'
import { clavesEjercicio } from '@lib/progreso'

interface Props {
  ejercicio: Ejercicio
}

const { ejercicio } = Astro.props
const { titulo, fuente, dificultad, tipo, simulaciones, preguntas, semaforos } = ejercicio.data
const interactivo =
  simulaciones.length > 0
    ? 'Gantt interactivo'
    : semaforos.length > 0
      ? 'Código con tests'
      : preguntas.length > 0
        ? 'Multiple choice'
        : null
const dif = dificultadUI[dificultad]
---

<a
  href={ejercicioHref(ejercicio.id)}
  class:list={[
    'group flex h-full flex-col rounded-xl border border-line bg-surface-2 p-4 hover:border-line-strong transition-colors',
    'data-resuelto:border-ok/70 data-resuelto:hover:border-ok',
  ]}
  data-ejercicio-card
  data-claves={clavesEjercicio(ejercicioHref(ejercicio.id), ejercicio.data).join('|')}
  data-tema={ejercicio.data.tema.id}
  data-dificultad={dificultad}
  data-simulador={interactivo ? 'si' : 'no'}
>
  <span class="flex items-center gap-2 font-mono text-[11px] text-muted">
    {rotuloEjercicio(fuente.numero)}
    <span class="ml-auto hidden text-ok group-data-resuelto:inline">✓ Resuelto</span>
  </span>
  <span class="mt-1 font-heading text-fg group-hover:text-accent">{titulo}</span>
  <span class="mt-auto pt-3 flex flex-wrap items-center gap-2 text-[11px]">
    <span class="inline-flex items-center gap-1.5 text-fg-soft">
      <span class="size-1.5 rounded-full" style={`background:${dif.color}`}></span>
      {dif.label}
    </span>
    <span class="text-muted">· {tipoUI[tipo]}</span>
    {interactivo && (
      <span class="ml-auto rounded-full bg-accent-soft px-2 py-0.5 text-accent">{interactivo}</span>
    )}
  </span>
</a>
