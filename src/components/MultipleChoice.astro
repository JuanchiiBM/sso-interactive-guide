---
/** Pregunta multiple choice con la respuesta bloqueada. Comportamiento: src/lib/desafios/multiple-choice.ts */
import { markdownAHtml } from '@lib/markdown/marked'

interface Props {
  pregunta: {
    enunciado: string
    opciones: { texto: string; explicacion?: string }[]
    correcta: number
    justificacion: string
  }
  /** Identificador estable en la página (para el progreso guardado). */
  clave: string
  /** `examen`: sin Verificar ni Me rindo; lo corrige el simulacro al finalizar. */
  modo?: 'practica' | 'examen'
}

const { pregunta, clave, modo = 'practica' } = Astro.props
const justificacion = await markdownAHtml(pregunta.justificacion)
const nombre = `mc-${clave}`
---

<section
  class="rounded-xl border border-line bg-surface-2 p-4 md:p-5"
  data-mc
  data-mc-clave={clave}
  data-mc-correcta={pregunta.correcta}
  data-mc-modo={modo}
>
  <p class="font-medium text-fg">{pregunta.enunciado}</p>

  <fieldset class="mt-4 flex flex-col gap-2">
    <legend class="sr-only">Opciones</legend>
    {pregunta.opciones.map((op, i) => (
      <label class="mc-opcion" data-mc-opcion={i}>
        <input type="radio" name={nombre} value={i} class="mt-1 accent-[var(--accent)]" />
        <span class="flex flex-col gap-1">
          <span class="text-sm text-fg-soft">{op.texto}</span>
          {op.explicacion && (
            <span class="text-xs text-muted" data-mc-explicacion hidden>
              {op.explicacion}
            </span>
          )}
        </span>
      </label>
    ))}
  </fieldset>

  {modo === 'practica' && (
    <>
      <div class="mt-4 flex flex-wrap items-center gap-2">
        <button
          type="button"
          class="rounded-lg bg-fg text-surface px-3 py-1.5 text-sm font-medium hover:opacity-90"
          data-mc-accion="verificar"
        >
          Verificar
        </button>
        <button
          type="button"
          class="ml-auto rounded-lg px-3 py-1.5 text-sm boton-rendirse"
          data-mc-accion="resolucion"
        >
          Me rindo
        </button>
      </div>
      <p class="mt-2 text-sm min-h-5" aria-live="polite" data-mc-feedback></p>
    </>
  )}

  <div class="mt-4 border-t border-line pt-4" data-mc-respuesta hidden>
    <h3 class="font-heading text-sm text-ok mb-2">Respuesta</h3>
    <div class="prose max-w-none" set:html={justificacion} />
  </div>
</section>
